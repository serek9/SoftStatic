# Same line endings on Windows and macOS, whatever each machine's core.autocrlf says.
* text=auto eol=lf

*.js   text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.css  text eol=lf

# Binary artwork, icons and other assets
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
